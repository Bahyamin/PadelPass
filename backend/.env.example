PORT=3000

# Secret used to sign the login tokens (JWT). Use a long random value outside development.
JWT_SECRET=change-me-dev-only-secret

# Local PostgreSQL started with `docker compose up -d` (see docker-compose.yml)
DATABASE_URL=postgresql://padelpass:padelpass@localhost:5433/padelpass

# Passwords of the accounts created by `npx prisma db seed` (development values, change them)
SEED_ADMIN_PASSWORD=Admin1234
SEED_STAFF_PASSWORD=Staff1234

# Address of the front end, used in the links sent by email
APP_URL=http://localhost:5173

# Emails: Mailtrap in development (https://mailtrap.io > Email Testing > Inbox > SMTP).
# With SMTP_HOST empty, the emails are printed in the backend console instead of being sent.
# Mailtrap host: sandbox.smtp.mailtrap.io
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PadelBook <no-reply@padelbook.local>
